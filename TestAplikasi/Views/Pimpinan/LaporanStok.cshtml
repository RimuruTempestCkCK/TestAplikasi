@{
    ViewBag.Title = "Laporan Stok Terkini";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>Error!</strong> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row">
    <div class="col-md-12 grid-margin">
        <div class="row">
            <div class="col-12 col-xl-8 mb-4 mb-xl-0">
                <h3 class="font-weight-bold">
                    <i class="icon-package menu-icon"></i> Laporan Stok Terkini
                </h3>
                <h6 class="font-weight-normal mb-0">
                    Kondisi stok produk saat ini &mdash; @DateTime.Now.ToString("dddd, dd MMMM yyyy", new System.Globalization.CultureInfo("id-ID"))
                </h6>
            </div>
            <div class="col-12 col-xl-4">
                <div class="justify-content-end d-flex gap-2">
                    <button class="btn btn-primary btn-sm" onclick="window.print()">
                        <i class="icon-printer me-2"></i> Cetak
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <p class="card-title mb-0">Stok Produk Terkini</p>
                    <input type="text" class="form-control form-control-sm" id="filterProduk" placeholder="Cari produk..." style="width: 250px;">
                </div>
                <div class="table-responsive">
                    <table class="table table-hover table-striped" id="stokTable">
                        <thead>
                            <tr>
                                <th>No</th>
                                <th>Nama Produk</th>
                                <th class="text-end">Harga</th>
                                <th class="text-end">Harga Modal</th>
                                <th class="text-end">Harga Jual</th>
                                <th class="text-center">Stok</th>
                                <th class="text-end">Nilai Stok</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int no = 1;
                                var data = (List<TestAplikasi.Models.LaporanStokModel>)ViewBag.DataLaporan;
                                decimal totalNilai = 0;
                                if (data != null && data.Count > 0)
                                {
                                    foreach (var item in data)
                                    {
                                        decimal nilaiStok = item.NilaiStok;
                                        totalNilai += nilaiStok;
                                        <tr>
                                            <td>@no</td>
                                            <td><strong>@item.NamaProduk</strong></td>
                                            <td class="text-end">Rp @string.Format("{0:N0}", item.Harga)</td>
                                            <td class="text-end">Rp @string.Format("{0:N0}", item.HargaModal)</td>
                                            <td class="text-end">Rp @string.Format("{0:N0}", item.HargaJual)</td>
                                            <td class="text-center">
                                                <span class="badge @(item.TotalStok > 0 ? "bg-success" : "bg-danger")">
                                                    @item.TotalStok unit
                                                </span>
                                            </td>
                                            <td class="text-end"><strong>Rp @string.Format("{0:N0}", nilaiStok)</strong></td>
                                        </tr>
                                        no++;
                                    }
                                    <tr style="background-color: #f8f9fa; font-weight: bold;">
                                        <td colspan="6" class="text-end">TOTAL NILAI STOK:</td>
                                        <td class="text-end">Rp @string.Format("{0:N0}", totalNilai)</td>
                                    </tr>
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="7" class="text-center text-muted">Tidak ada data stok</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.getElementById('filterProduk').addEventListener('keyup', function () {
        const filter = this.value.toLowerCase();
        document.getElementById('stokTable').querySelector('tbody').querySelectorAll('tr').forEach(row => {
            if (row.cells.length > 1) {
                const produk = row.cells[1].textContent.toLowerCase();
                const show = produk.includes(filter);
                row.style.display = show ? '' : 'none';
            }
        });
    });
</script>
