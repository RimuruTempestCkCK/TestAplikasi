@{
    ViewBag.Title = "Dashboard Pimpinan";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>Error!</strong> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row">
    <div class="col-md-12 grid-margin">
        <div class="row">
            <div class="col-12 col-xl-8 mb-4 mb-xl-0">
                <h3 class="font-weight-bold">Selamat Datang, Pimpinan</h3>
                <h6 class="font-weight-normal mb-0">
                    Selamat datang di Dashboard Pimpinan &mdash; @DateTime.Now.ToString("dddd, dd MMMM yyyy", new System.Globalization.CultureInfo("id-ID"))
                </h6>
            </div>
            <div class="col-12 col-xl-4">
                <div class="justify-content-end d-flex">
                    <a href="@Url.Action("Laporan","Pimpinan")" class="btn btn-primary btn-sm">
                        <i class="mdi mdi-file-document me-1"></i> Laporan
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12 grid-margin">
        <h5 class="mb-3">Statistik Harian</h5>
    </div>
</div>

<div class="row">
    <div class="col-md-3 grid-margin stretch-card">
        <div class="card card-tale">
            <div class="card-body">
                <p class="mb-4">Transaksi Hari Ini</p>
                <p class="fs-30 mb-2">@(ViewBag.TxHariIni ?? 0)</p>
                <p class="mb-0 text-white-50">transaksi</p>
            </div>
        </div>
    </div>
    <div class="col-md-3 grid-margin stretch-card">
        <div class="card card-dark-blue">
            <div class="card-body">
                <p class="mb-4">Pendapatan Hari Ini</p>
                <p class="fs-30 mb-2">Rp @(ViewBag.PendapatanHariIni != null ? string.Format("{0:N0}", (decimal)ViewBag.PendapatanHariIni) : "0")</p>
                <p class="mb-0 text-white-50">total penjualan</p>
            </div>
        </div>
    </div>
    <div class="col-md-3 grid-margin stretch-card">
        <div class="card card-light-blue">
            <div class="card-body">
                <p class="mb-4">Transaksi Bulan Ini</p>
                <p class="fs-30 mb-2">@(ViewBag.TxBulanIni ?? 0)</p>
                <p class="mb-0 text-white-50">bulan ini</p>
            </div>
        </div>
    </div>
    <div class="col-md-3 grid-margin stretch-card">
        <div class="card card-light-danger">
            <div class="card-body">
                <p class="mb-4">Pendapatan Bulan Ini</p>
                <p class="fs-30 mb-2">Rp @(ViewBag.PendapatanBulanIni != null ? string.Format("{0:N0}", (decimal)ViewBag.PendapatanBulanIni) : "0")</p>
                <p class="mb-0 text-white-50">bulan ini</p>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12 grid-margin">
        <h5 class="mb-3">Statistik Keseluruhan</h5>
    </div>
</div>

<div class="row">
    <div class="col-md-3 grid-margin stretch-card">
        <div class="card card-tale">
            <div class="card-body">
                <p class="mb-4">Total Transaksi</p>
                <p class="fs-30 mb-2">@(ViewBag.TotalTx ?? 0)</p>
                <p class="mb-0 text-white-50">semua waktu</p>
            </div>
        </div>
    </div>
    <div class="col-md-3 grid-margin stretch-card">
        <div class="card card-dark-blue">
            <div class="card-body">
                <p class="mb-4">Total Pendapatan</p>
                <p class="fs-30 mb-2">Rp @(ViewBag.TotalPendapatan != null ? string.Format("{0:N0}", (decimal)ViewBag.TotalPendapatan) : "0")</p>
                <p class="mb-0 text-white-50">semua waktu</p>
            </div>
        </div>
    </div>
    <div class="col-md-3 grid-margin stretch-card">
        <div class="card card-light-blue">
            <div class="card-body">
                <p class="mb-4">Total Produk</p>
                <p class="fs-30 mb-2">@(ViewBag.TotalProduk ?? 0)</p>
                <p class="mb-0 text-white-50">di sistem</p>
            </div>
        </div>
    </div>
    <div class="col-md-3 grid-margin stretch-card">
        <div class="card card-light-danger">
            <div class="card-body">
                <p class="mb-4">Total Stok</p>
                <p class="fs-30 mb-2">@(ViewBag.TotalStok ?? 0)</p>
                <p class="mb-0 text-white-50">unit tersedia</p>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12 grid-margin">
        <h5 class="mb-3">Sumber Daya Manusia</h5>
    </div>
</div>

<div class="row">
    <div class="col-md-4 grid-margin stretch-card">
        <div class="card card-tale">
            <div class="card-body">
                <p class="mb-4">Jumlah Kasir Aktif</p>
                <p class="fs-30 mb-2">@(ViewBag.JumlahKasir ?? 0)</p>
                <p class="mb-0 text-white-50">kasir aktif</p>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <p class="card-title mb-0">Grafik Penjualan 7 Hari Terakhir</p>
                    <a href="@Url.Action("Laporan","Pimpinan")" class="text-info">Lihat Laporan Lengkap</a>
                </div>
                <p class="text-muted small">Total pendapatan per hari dari semua transaksi.</p>
                <canvas id="grafikPenjualan" height="80"></canvas>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var labels = @Html.Raw(ViewBag.LabelGrafik ?? "[]");
            var data   = @Html.Raw(ViewBag.DataGrafik ?? "[]");

            var ctx = document.getElementById('grafikPenjualan').getContext('2d');
            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Pendapatan (Rp)',
                        data: data,
                        backgroundColor: 'rgba(54, 162, 235, 0.6)',
                        borderColor: 'rgba(54, 162, 235, 1)',
                        borderWidth: 1,
                        borderRadius: 4
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function(ctx) {
                                    return 'Rp ' + ctx.parsed.y.toLocaleString('id-ID');
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function(v) {
                                    return 'Rp ' + v.toLocaleString('id-ID');
                                }
                            }
                        }
                    }
                }
            });
        })();
    </script>
}