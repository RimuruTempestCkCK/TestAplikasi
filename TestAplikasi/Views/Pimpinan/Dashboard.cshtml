@{
    ViewBag.Title = "Dashboard Pimpinan";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var topProduk = ViewBag.TopProduk as List<TestAplikasi.Models.DashboardProdukModel>;
    var performaKasir = ViewBag.PerformaKasir as List<TestAplikasi.Models.DashboardKasirModel>;
    decimal growth = (decimal)(ViewBag.Growth ?? 0m);
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>Error!</strong> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row">
    <div class="col-md-12 grid-margin">
        <div class="row">
            <div class="col-12 col-xl-8 mb-4 mb-xl-0">
                <h3 class="font-weight-bold">Ringkasan Eksekutif</h3>
                <h6 class="font-weight-normal mb-0">Laporan performa bisnis dan intelijen data &mdash; <span class="text-primary">@DateTime.Now.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("id-ID"))</span></h6>
            </div>
            <div class="col-12 col-xl-4">
                <div class="justify-content-end d-flex">
                    <div class="dropdown flex-md-grow-1 flex-xl-grow-0">
                        <button class="btn btn-sm btn-light bg-white dropdown-toggle" type="button" id="dropdownMenuDate2" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="true">
                            <i class="mdi mdi-calendar"></i> Laporan Bulanan (@DateTime.Now.ToString("MMMM yyyy"))
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-3 grid-margin stretch-card">
        <div class="card card-tale">
            <div class="card-body">
                <p class="mb-4">Pendapatan Hari Ini</p>
                <p class="fs-30 mb-2">Rp @string.Format("{0:N0}", ViewBag.PendapatanHariIni)</p>
                <p>Total omset hari ini</p>
            </div>
        </div>
    </div>
    <div class="col-md-3 grid-margin stretch-card">
        <div class="card card-dark-blue">
            <div class="card-body">
                <p class="mb-4">Pendapatan Bulan Ini</p>
                <p class="fs-30 mb-2">Rp @string.Format("{0:N0}", ViewBag.PendapatanBulanIni)</p>
                <div class="d-flex align-items-center">
                    <p class="mb-0 @(growth >= 0 ? "text-success" : "text-danger")">
                        <i class="mdi mdi-arrow-@(growth >= 0 ? "up" : "down")-bold me-1"></i>@(Math.Abs(growth).ToString("N1"))%
                    </p>
                    <span class="ms-2 small opacity-75">vs bln lalu</span>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 grid-margin stretch-card">
        <div class="card card-light-blue">
            <div class="card-body">
                <p class="mb-4">Transaksi Bulan Ini</p>
                <p class="fs-30 mb-2">@ViewBag.TxBulanIni</p>
                <p>Total transaksi @DateTime.Now.ToString("MMMM")</p>
            </div>
        </div>
    </div>
    <div class="col-md-3 grid-margin stretch-card">
        <div class="card card-light-danger">
            <div class="card-body">
                <p class="mb-4">Total Pendapatan</p>
                <p class="fs-30 mb-2">Rp @string.Format("{0:N0}", ViewBag.TotalPendapatan)</p>
                <p>Akumulasi seluruh waktu</p>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-7 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <p class="card-title mb-0">Tren Penjualan (7 Hari)</p>
                    <p class="text-muted small">Visualisasi pendapatan harian seminggu terakhir.</p>
                </div>
                <canvas id="pimpinanSalesChartEnhanced" height="150"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-5 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <p class="card-title">Proporsi Penjualan Produk</p>
                <p class="font-weight-500 text-muted small">Distribusi volume penjualan 5 produk terlaris.</p>
                <div class="mt-4">
                    <canvas id="pimpinanTopProductChart"></canvas>
                </div>
                <div id="pimpinanTopProductLegend" class="mt-4"></div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <p class="card-title mb-0">Ranking Kontribusi Kasir</p>
                <div class="table-responsive">
                    <table class="table table-striped table-borderless">
                        <thead>
                            <tr>
                                <th>Nama Kasir</th>
                                <th>Jumlah Transaksi</th>
                                <th>Total Kontribusi</th>
                                <th>Progress Terhadap Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (performaKasir != null)
                            {
                                decimal totalAll = performaKasir.Sum(k => k.TotalPendapatan);
                                foreach (var k in performaKasir)
                                {
                                    decimal percent = totalAll > 0 ? (k.TotalPendapatan / totalAll) * 100 : 0;
                                    <tr>
                                        <td class="font-weight-bold text-dark">@k.NamaKasir</td>
                                        <td class="font-weight-bold">@k.JumlahTransaksi</td>
                                        <td>Rp @string.Format("{0:N0}", k.TotalPendapatan)</td>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="progress flex-grow-1 progress-md">
                                                    <div class="progress-bar bg-primary" role="progressbar" style="width: @(percent.ToString("0"))%" aria-valuenow="@(percent.ToString("0"))" aria-valuemin="0" aria-valuemax="100"></div>
                                                </div>
                                                <span class="ms-2 font-weight-bold small text-primary">@percent.ToString("0")%</span>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function ($) {
            'use strict';
            $(function () {
                // Sales Trend Chart
                if ($("#pimpinanSalesChartEnhanced").length) {
                    const ctx = document.getElementById('pimpinanSalesChartEnhanced');
                    var labels = @Html.Raw(ViewBag.LabelGrafik ?? "[]");
                    var data = @Html.Raw(ViewBag.DataGrafik ?? "[]");
                    
                    new Chart(ctx, {
                        type: 'line',
                        data: {
                            labels: labels,
                            datasets: [{
                                label: 'Pendapatan',
                                data: data,
                                borderColor: '#4B49AC',
                                borderWidth: 3,
                                fill: true,
                                backgroundColor: 'rgba(75, 73, 172, 0.15)',
                                tension: 0.4,
                                pointRadius: 5,
                                pointBackgroundColor: '#4B49AC',
                                pointBorderColor: 'white',
                                pointBorderWidth: 2
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: true,
                            scales: {
                                x: { grid: { display: false }, ticks: { color: "#6C7383" } },
                                y: {
                                    grid: { color: "#f3f3f3" },
                                    ticks: {
                                        color: "#6C7383",
                                        callback: function(v) { return 'Rp ' + v.toLocaleString('id-ID'); }
                                    }
                                }
                            },
                            plugins: {
                                legend: { display: false },
                                tooltip: {
                                    backgroundColor: 'rgba(255, 255, 255, 0.9)',
                                    titleColor: '#333',
                                    bodyColor: '#333',
                                    borderColor: '#4B49AC',
                                    borderWidth: 1,
                                    callbacks: {
                                        label: function(ctx) { return 'Rp ' + ctx.parsed.y.toLocaleString('id-ID'); }
                                    }
                                }
                            }
                        }
                    });
                }

                // Top Products Doughnut
                if ($("#pimpinanTopProductChart").length) {
                    const ctx = document.getElementById('pimpinanTopProductChart');
                    var labelsProduk = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(topProduk?.Select(p => p.NamaProduk).ToList() ?? new List<string>()));
                    var dataProduk = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(topProduk?.Select(p => p.TotalTerjual).ToList() ?? new List<int>()));

                    const chart = new Chart(ctx, {
                        type: 'doughnut',
                        data: {
                            labels: labelsProduk,
                            datasets: [{
                                data: dataProduk,
                                backgroundColor: ["#4B49AC", "#FFC100", "#248AFD", "#FF4747", "#57B657"],
                                borderColor: "white",
                                borderWidth: 3
                            }]
                        },
                        options: {
                            cutout: '75%',
                            responsive: true,
                            maintainAspectRatio: true,
                            plugins: { legend: { display: false } }
                        }
                    });

                    const legendContainer = document.getElementById('pimpinanTopProductLegend');
                    if (legendContainer) {
                        let legendHtml = '<ul class="list-unstyled">';
                        chart.data.labels.forEach((label, i) => {
                            legendHtml += `
                                <li class="d-flex align-items-center mb-2">
                                    <span class="me-2" style="width: 12px; height: 12px; border-radius: 50%; background-color: ${chart.data.datasets[0].backgroundColor[i]}"></span>
                                    <span class="text-muted small">${label}</span>
                                    <span class="ms-auto font-weight-bold small">${chart.data.datasets[0].data[i]} unit</span>
                                </li>
                            `;
                        });
                        legendHtml += '</ul>';
                        legendContainer.innerHTML = legendHtml;
                    }
                }
            });
        })(jQuery);
    </script>
}script>
}