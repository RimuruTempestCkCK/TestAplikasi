@{
    ViewBag.Title = "Dashboard Kasir";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var listTx = ViewBag.ListTxTerakhir as List<TestAplikasi.Models.TransaksiModel>;
    string labelGrafik = ViewBag.LabelGrafik ?? "[]";
    string dataGrafik = ViewBag.DataGrafik ?? "[]";
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>Error!</strong> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@*{{-- Header --}}*@
<div class="row">
    <div class="col-md-12 grid-margin">
        <div class="row">
            <div class="col-12 col-xl-8 mb-4 mb-xl-0">
                <h3 class="font-weight-bold">Selamat Datang, @Session["Nama"]</h3>
                <h6 class="font-weight-normal mb-0">
                    Login sebagai <span class="text-primary">Kasir</span> &mdash; @DateTime.Now.ToString(
        "dddd, dd MMMM yyyy",
        new System.Globalization.CultureInfo("id-ID")
        )
                </h6>
            </div>
            <div class="col-12 col-xl-4">
                <div class="justify-content-end d-flex">
                    <a href="@Url.Action("Transaksi","Kasir")" class="btn btn-primary btn-sm">
                        <i class="mdi mdi-plus me-1"></i> Transaksi Baru
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@*{{-- Kartu Statistik --}}*@
<div class="row">
    <div class="col-md-3 grid-margin stretch-card">
        <div class="card card-tale">
            <div class="card-body">
                <p class="mb-4">Transaksi Hari Ini</p>
                <p class="fs-30 mb-2">@ViewBag.TxHariIni</p>
                <p class="mb-0 text-white-50">transaksi</p>
            </div>
        </div>
    </div>
    <div class="col-md-3 grid-margin stretch-card">
        <div class="card card-dark-blue">
            <div class="card-body">
                <p class="mb-4">Pendapatan Hari Ini</p>
                <p class="fs-30 mb-2">
                    Rp @string.Format("{0:N0}", ViewBag.PendapatanHariIni)
                </p>
                <p class="mb-0 text-white-50">dari kasir ini</p>
            </div>
        </div>
    </div>
    <div class="col-md-3 grid-margin stretch-card">
        <div class="card card-light-blue">
            <div class="card-body">
                <p class="mb-4">Total Transaksi</p>
                <p class="fs-30 mb-2">@ViewBag.TotalTx</p>
                <p class="mb-0 text-white-50">semua waktu</p>
            </div>
        </div>
    </div>
    <div class="col-md-3 grid-margin stretch-card">
        <div class="card card-light-danger">
            <div class="card-body">
                <p class="mb-4">Total Pendapatan</p>
                <p class="fs-30 mb-2">
                    Rp @string.Format("{0:N0}", ViewBag.TotalPendapatan)
                </p>
                <p class="mb-0 text-white-50">semua waktu</p>
            </div>
        </div>
    </div>
</div>

@*{{-- Grafik Penjualan 7 Hari --}}*@
<div class="row">
    <div class="col-md-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <p class="card-title mb-0">Grafik Penjualan 7 Hari Terakhir</p>
                    <a href="@Url.Action("RiwayatTransaksi","Kasir")" class="text-info">Lihat Semua</a>
                </div>
                <p class="text-muted small">Total pendapatan per hari dari transaksi Anda.</p>
                <canvas id="grafikPenjualan" height="80"></canvas>
            </div>
        </div>
    </div>
</div>

@*{{-- Tabel Transaksi Terakhir --}}*@
<div class="row">
    <div class="col-md-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <p class="card-title mb-0">10 Transaksi Terakhir</p>
                    <a href="@Url.Action("RiwayatTransaksi","Kasir")" class="btn btn-light btn-sm">
                        <i class="mdi mdi-history me-1"></i> Riwayat Lengkap
                    </a>
                </div>
                <div class="table-responsive">
                    <table class="table table-striped table-borderless">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>No. Transaksi</th>
                                <th>Total</th>
                                <th>Tanggal</th>
                                <th>Aksi</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (listTx != null && listTx.Count > 0)
                            {
                                int no = 1;
                                foreach (var tx in listTx)
                                {
                                    <tr>
                                        <td>@no</td>
                                        <td><span class="badge badge-info">@tx.NomorTransaksi</span></td>
                                        <td class="font-weight-bold">Rp @tx.TotalHarga.ToString("N0")</td>
                                        <td>@tx.TanggalTransaksi.ToString("dd MMM yyyy, HH:mm")</td>
                                        <td>
                                            <a href="@Url.Action("StrukTransaksi","Kasir", new { id = tx.Id })"
                                               class="btn btn-inverse-info btn-icon-text btn-sm">
                                                <i class="mdi mdi-receipt btn-icon-prepend"></i> Struk
                                            </a>
                                        </td>
                                    </tr>
                                    no++;
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted">Belum ada transaksi.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var labels = @Html.Raw(labelGrafik);
            var data   = @Html.Raw(dataGrafik);

            var ctx = document.getElementById('grafikPenjualan').getContext('2d');
            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Pendapatan (Rp)',
                        data: data,
                        backgroundColor: 'rgba(54, 162, 235, 0.6)',
                        borderColor: 'rgba(54, 162, 235, 1)',
                        borderWidth: 1,
                        borderRadius: 4
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function(ctx) {
                                    return 'Rp ' + ctx.parsed.y.toLocaleString('id-ID');
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function(v) {
                                    return 'Rp ' + v.toLocaleString('id-ID');
                                }
                            }
                        }
                    }
                }
            });
        })();
    </script>
}