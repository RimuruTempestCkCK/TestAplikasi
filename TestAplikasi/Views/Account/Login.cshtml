@{
    ViewBag.Title = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>Login - SiKasir.exe</title>
    
    <!-- Vendor Styles -->
    <link rel="stylesheet" href="@Url.Content("~/Content/templete/dist/assets/vendors/feather/feather.css")">
    <link rel="stylesheet" href="@Url.Content("~/Content/templete/dist/assets/vendors/ti-icons/css/themify-icons.css")">
    <link rel="stylesheet" href="@Url.Content("~/Content/templete/dist/assets/vendors/css/vendor.bundle.base.css")">
    <link rel="stylesheet" href="@Url.Content("~/Content/templete/dist/assets/vendors/font-awesome/css/font-awesome.min.css")">
    <link rel="stylesheet" href="@Url.Content("~/Content/templete/dist/assets/vendors/mdi/css/materialdesignicons.min.css")">
    
    <!-- Main Style -->
    <link rel="stylesheet" href="@Url.Content("~/Content/templete/dist/assets/css/style.css")">
    <link rel="shortcut icon" href="@Url.Content("~/Content/templete/dist/assets/images/favicon.png")" />

    <style>
        /* Penyesuaian agar tampilan lebih 'clean' */
        .brand-text {
            font-size: 2.5rem;
            font-weight: 700;
            color: #4B49AC; /* Warna utama khas Skydash */
            margin-bottom: 10px;
            letter-spacing: -1px;
        }
        .brand-text span {
            color: #7DA0FA; /* Warna sekunder untuk variasi .exe */
        }
        .auth-form-light {
            border-radius: 15px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.05);
        }
        .form-control {
            border-radius: 8px !important;
        }
        .auth-form-btn {
            border-radius: 8px !important;
            box-shadow: 0 4px 10px rgba(75, 73, 172, 0.3);
        }
    </style>
</head>
<body>
    <div class="container-scroller">
        <div class="container-fluid page-body-wrapper full-page-wrapper">
            <div class="content-wrapper d-flex align-items-center auth px-0">
                <div class="row w-100 mx-0">
                    <div class="col-lg-4 mx-auto">
                        <div class="auth-form-light text-center py-5 px-4 px-sm-5">

                            <!-- Logo diganti teks SiKasir.exe -->
                            <div class="brand-logo mb-4">
                                <h2 class="brand-text">SiKasir<span>.exe</span></h2>
                            </div>

                            @*<h4 class="font-weight-bold">Selamat Datang!</h4>*@
                            <h6 class="font-weight-light">Silakan login untuk masuk ke sistem.</h6>

                            @if (ViewBag.Error != null)
                            {
                                <div class="alert alert-danger mt-3 py-2 d-flex align-items-center justify-content-center" role="alert">
                                    <i class="ti-alert me-2"></i>
                                    <span class="small">@ViewBag.Error</span>
                                </div>
                            }

                            @using (Html.BeginForm("Login", "Account", FormMethod.Post, new { @class = "pt-4 text-left" }))
                            {
                                @Html.AntiForgeryToken()

                                <div class="form-group mb-3">
                                    @*<label class="small font-weight-bold">Username</label>*@
                                    <div class="input-group">
                                        <input type="text"
                                               name="Username"
                                               class="form-control form-control-lg border-left-0"
                                               placeholder="Masukkan username"
                                               value="@Request.Form["Username"]"
                                               autocomplete="off"
                                               required />
                                    </div>
                                </div>

                                <div class="form-group mb-4">
                                    @*<label class="small font-weight-bold">Password</label>*@
                                    <input type="password"
                                           name="Password"
                                           class="form-control form-control-lg"
                                           placeholder="********"
                                           required />
                                </div>

                                <div class="mt-3 d-grid gap-2">
                                    <button type="submit"
                                            class="btn btn-block btn-primary btn-lg font-weight-medium auth-form-btn">
                                        MASUK SEKARANG
                                    </button>
                                </div>

                                <div class="text-center mt-4 font-weight-light">
                                    &copy; @DateTime.Now.Year SiKasir.exe
                                </div>

                                @*<div class="text-center mt-4 font-weight-light">
                                    &copy; @DateTime.Now.Year SiKasir.exe - Management System
                                </div>*@
                            }

                        </div>
                    </div>
                </div>
            </div>
            <!-- content-wrapper ends -->
        </div>
        <!-- page-body-wrapper ends -->
    </div>

    <!-- Scripts -->
    <script src="@Url.Content("~/Content/templete/dist/assets/vendors/js/vendor.bundle.base.js")"></script>
    <script src="@Url.Content("~/Content/templete/dist/assets/js/off-canvas.js")"></script>
    <script src="@Url.Content("~/Content/templete/dist/assets/js/template.js")"></script>
    <script src="@Url.Content("~/Content/templete/dist/assets/js/settings.js")"></script>
    <script src="@Url.Content("~/Content/templete/dist/assets/js/todolist.js")"></script>
</body>
</html>