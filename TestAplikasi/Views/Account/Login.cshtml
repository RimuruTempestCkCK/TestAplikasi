@{
    ViewBag.Title = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>Login - TestAplikasi</title>
    <link rel="stylesheet" href="@Url.Content("~/Content/templete/dist/assets/vendors/feather/feather.css")">
    <link rel="stylesheet" href="@Url.Content("~/Content/templete/dist/assets/vendors/ti-icons/css/themify-icons.css")">
    <link rel="stylesheet" href="@Url.Content("~/Content/templete/dist/assets/vendors/css/vendor.bundle.base.css")">
    <link rel="stylesheet" href="@Url.Content("~/Content/templete/dist/assets/vendors/font-awesome/css/font-awesome.min.css")">
    <link rel="stylesheet" href="@Url.Content("~/Content/templete/dist/assets/vendors/mdi/css/materialdesignicons.min.css")">
    <link rel="stylesheet" href="@Url.Content("~/Content/templete/dist/assets/css/style.css")">
    <link rel="shortcut icon" href="@Url.Content("~/Content/templete/dist/assets/images/favicon.png")" />
</head>
<body>
    <div class="container-scroller">
        <div class="container-fluid page-body-wrapper full-page-wrapper">
            <div class="content-wrapper d-flex align-items-center auth px-0">
                <div class="row w-100 mx-0">
                    <div class="col-lg-4 mx-auto">
                        <div class="auth-form-light text-left py-5 px-4 px-sm-5">

                            <div class="brand-logo">
                                <img src="@Url.Content("~/Content/templete/dist/assets/images/logo.svg")" alt="logo">
                            </div>

                            <h4>Hello! let's get started</h4>
                            <h6 class="font-weight-light">Sign in to continue.</h6>

                            @* Tampilkan pesan error login *@
                            @if (ViewBag.Error != null)
                            {
                                <div class="alert alert-danger mt-3 py-2 d-flex align-items-center" role="alert">
                                    <i class="ti-alert me-2"></i>
                                    <span>@ViewBag.Error</span>
                                </div>
                            }

                            @using (Html.BeginForm("Login", "Account", FormMethod.Post, new { @class = "pt-3" }))
                            {
                                @Html.AntiForgeryToken()

                                <div class="form-group">
                                    <input type="text"
                                           name="Username"
                                           class="form-control form-control-lg"
                                           placeholder="Username"
                                           value="@Request.Form["Username"]"
                                           autocomplete="off" />
                                </div>

                                <div class="form-group">
                                    <input type="password"
                                           name="Password"
                                           class="form-control form-control-lg"
                                           placeholder="Password" />
                                </div>

                                <div class="mt-3 d-grid gap-2">
                                    <button type="submit"
                                            class="btn btn-block btn-primary btn-lg font-weight-medium auth-form-btn">
                                        SIGN IN
                                    </button>
                                </div>
                            }

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="@Url.Content("~/Content/templete/dist/assets/vendors/js/vendor.bundle.base.js")"></script>
    <script src="@Url.Content("~/Content/templete/dist/assets/js/off-canvas.js")"></script>
    <script src="@Url.Content("~/Content/templete/dist/assets/js/template.js")"></script>
    <script src="@Url.Content("~/Content/templete/dist/assets/js/settings.js")"></script>
    <script src="@Url.Content("~/Content/templete/dist/assets/js/todolist.js")"></script>
</body>
</html>