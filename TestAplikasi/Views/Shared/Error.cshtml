@{
    Layout = null;
    string role = Session["Role"]?.ToString();
}

<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8">
    <meta name="viewport"
          content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <title>404 - Halaman Tidak Ditemukan</title>

    <!-- plugins:css -->
    <link rel="stylesheet"
          href="@Url.Content("~/Content/templete/dist/assets/vendors/feather/feather.css")">

    <link rel="stylesheet"
          href="@Url.Content("~/Content/templete/dist/assets/vendors/ti-icons/css/themify-icons.css")">

    <link rel="stylesheet"
          href="@Url.Content("~/Content/templete/dist/assets/vendors/css/vendor.bundle.base.css")">

    <link rel="stylesheet"
          href="@Url.Content("~/Content/templete/dist/assets/vendors/font-awesome/css/font-awesome.min.css")">

    <link rel="stylesheet"
          href="@Url.Content("~/Content/templete/dist/assets/vendors/mdi/css/materialdesignicons.min.css")">

    <!-- inject:css -->
    <link rel="stylesheet"
          href="@Url.Content("~/Content/templete/dist/assets/css/style.css")">

    <link rel="shortcut icon"
          href="@Url.Content("~/Content/templete/dist/assets/images/favicon.png")" />
</head>

<body>

    <div class="container-scroller">
        <div class="container-fluid page-body-wrapper full-page-wrapper">

            <div class="content-wrapper d-flex align-items-center text-center error-page bg-primary">

                <div class="row flex-grow">
                    <div class="col-lg-7 mx-auto text-white">

                        <div class="row align-items-center d-flex flex-row">

                            <div class="col-lg-6 text-lg-right pe-lg-4">
                                <h1 class="display-1 mb-0">404</h1>
                            </div>

                            <div class="col-lg-6 error-page-divider text-lg-left ps-lg-4">
                                <h2>MAAF!</h2>
                                <h3 class="font-weight-light">
                                    Halaman yang Anda cari tidak ditemukan.
                                </h3>
                            </div>

                        </div>

                        <div class="row mt-5">
                            <div class="col-12 text-center mt-xl-2">

                                @if (role == "Admin")
                                {
                                    <a class="text-white font-weight-medium"
                                       href="@Url.Action("Dashboard", "Admin")">
                                        Kembali ke Dashboard
                                    </a>
                                }
                                else if (role == "Kasir")
                                {
                                    <a class="text-white font-weight-medium"
                                       href="@Url.Action("Dashboard", "Kasir")">
                                        Kembali ke Dashboard
                                    </a>
                                }
                                else if (role == "Pimpinan")
                                {
                                    <a class="text-white font-weight-medium"
                                       href="@Url.Action("Dashboard", "Pimpinan")">
                                        Kembali ke Dashboard
                                    </a>
                                }
                                else
                                {
                                    <a class="text-white font-weight-medium"
                                       href="@Url.Action("Login", "Account")">
                                        Kembali ke Login
                                    </a>
                                }

                            </div>
                        </div>

                        <div class="row mt-5">
                            <div class="col-12 mt-xl-2">

                                <p class="text-white font-weight-medium text-center">
                                    Copyright © @DateTime.Now.Year
                                    Developed by
                                    <strong>Firdinal Juliandre</strong>
                                </p>

                            </div>
                        </div>

                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- plugins:js -->
    <script src="@Url.Content("~/Content/templete/dist/assets/vendors/js/vendor.bundle.base.js")"></script>

    <!-- inject:js -->
    <script src="@Url.Content("~/Content/templete/dist/assets/js/off-canvas.js")"></script>
    <script src="@Url.Content("~/Content/templete/dist/assets/js/template.js")"></script>
    <script src="@Url.Content("~/Content/templete/dist/assets/js/settings.js")"></script>
    <script src="@Url.Content("~/Content/templete/dist/assets/js/todolist.js")"></script>

</body>
</html>