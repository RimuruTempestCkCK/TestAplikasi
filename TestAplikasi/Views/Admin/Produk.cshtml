@model List<TestAplikasi.Models.ProdukModel>
@{
    ViewBag.Title = "Kelola Produk";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <strong>Berhasil!</strong> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>Error!</strong> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row">
    <div class="col-lg-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                    <h4 class="card-title mb-0">Manajemen Produk</h4>
                    <div class="d-flex gap-2">
                        <a href="@Url.Action("Stok", "Admin")" class="btn btn-success btn-sm">
                            <i class="mdi mdi-package-variant-closed me-1"></i> Kelola Stok
                        </a>
                        <button type="button" class="btn btn-primary btn-sm"
                                data-bs-toggle="modal" data-bs-target="#modalTambahProduk">
                            <i class="mdi mdi-plus me-1"></i> Tambah Produk
                        </button>
                    </div>
                </div>
                <p class="card-description">Daftar seluruh produk beserta stok dan harga.</p>
                <div class="table-responsive">
                    <table class="table table-striped table-borderless" id="tabelProduk">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Nama Produk</th>
                                <th>Harga Modal</th>
                                <th>Harga Jual</th>
                                <th>Jumlah Tersedia</th>
                                <th>Deskripsi</th>
                                <th>Aksi</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Count > 0)
                            {
                                int no = 1;
                                foreach (var produk in Model)
                                {
                                    <tr>
                                        <td>@no</td>
                                        <td>@produk.NamaProduk</td>
                                        <td>Rp @produk.HargaModal.ToString("N0")</td>
                                        <td>Rp @produk.HargaJual.ToString("N0")</td>
                                        <td>
                                            <span class="badge @(produk.JumlahTersedia > 0 ? "badge-success" : "badge-danger")">
                                                @produk.JumlahTersedia
                                            </span>
                                        </td>
                                        <td>@produk.Deskripsi</td>
                                        <td>
                                            <button class="btn btn-inverse-warning btn-icon-text btn-sm btnEdit"
                                                    data-id="@produk.Id"
                                                    data-nama="@produk.NamaProduk"
                                                    data-hargamodal="@produk.HargaModal"
                                                    data-hargajual="@produk.HargaJual"
                                                    data-deskripsi="@produk.Deskripsi"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#modalEditProduk">
                                                <i class="ti-pencil btn-icon-prepend"></i> Edit
                                            </button>
                                            <button class="btn btn-inverse-danger btn-icon-text btn-sm btnHapus"
                                                    data-id="@produk.Id"
                                                    data-nama="@produk.NamaProduk"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#modalHapusProduk">
                                                <i class="ti-trash btn-icon-prepend"></i> Hapus
                                            </button>
                                        </td>
                                    </tr>
                                    no++;
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="text-center text-muted">Belum ada data produk.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@*{{-- MODAL TAMBAH --}}*@
<div class="modal fade" id="modalTambahProduk" tabindex="-1" aria-labelledby="labelTambahProduk" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="labelTambahProduk">
                    <i class="mdi mdi-package-variant me-2 text-primary"></i> Tambah Produk Baru
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            @using (Html.BeginForm("CreateProduk", "Admin", FormMethod.Post, new { id = "formTambahProduk" }))
            {
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="form-group">
                        <label>Nama Produk <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" name="NamaProduk"
                               placeholder="Masukkan nama produk" required>
                    </div>
                    <div class="form-group">
                        <label>Harga Modal <span class="text-danger">*</span></label>
                        <input type="number" class="form-control" name="HargaModal"
                               placeholder="Masukkan harga modal" min="0" step="100" required>
                    </div>
                    <div class="form-group">
                        <label>Harga Jual <span class="text-danger">*</span></label>
                        <input type="number" class="form-control" name="HargaJual"
                               placeholder="Masukkan harga jual" min="0" step="100" required>
                    </div>
                    <div class="form-group">
                        <label>Deskripsi</label>
                        <textarea class="form-control" name="Deskripsi"
                                  placeholder="Masukkan deskripsi produk" rows="3"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Batal</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="ti-save me-1"></i> Simpan
                    </button>
                </div>
            }
        </div>
    </div>
</div>

@*{{-- MODAL EDIT --}}*@
<div class="modal fade" id="modalEditProduk" tabindex="-1" aria-labelledby="labelEditProduk" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="labelEditProduk">
                    <i class="ti-pencil me-2 text-warning"></i> Edit Produk
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            @using (Html.BeginForm("EditProduk", "Admin", FormMethod.Post, new { id = "formEditProduk" }))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" id="editProdukId" name="Id" />
                <div class="modal-body">
                    <div class="form-group">
                        <label>Nama Produk <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="editNamaProduk" name="NamaProduk"
                               placeholder="Masukkan nama produk" required>
                    </div>
                    <div class="form-group">
                        <label>Harga Modal <span class="text-danger">*</span></label>
                        <input type="number" class="form-control" id="editHargaModal" name="HargaModal"
                               placeholder="Masukkan harga modal" min="0" step="100" required>
                    </div>
                    <div class="form-group">
                        <label>Harga Jual <span class="text-danger">*</span></label>
                        <input type="number" class="form-control" id="editHargaJual" name="HargaJual"
                               placeholder="Masukkan harga jual" min="0" step="100" required>
                    </div>
                    <div class="form-group">
                        <label>Deskripsi</label>
                        <textarea class="form-control" id="editDeskripsi" name="Deskripsi"
                                  placeholder="Masukkan deskripsi produk" rows="3"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Batal</button>
                    <button type="submit" class="btn btn-warning">
                        <i class="ti-save me-1"></i> Update
                    </button>
                </div>
            }
        </div>
    </div>
</div>

@*{{-- MODAL HAPUS --}}*@
<div class="modal fade" id="modalHapusProduk" tabindex="-1" aria-labelledby="labelHapusProduk" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="labelHapusProduk">
                    <i class="ti-trash me-2 text-danger"></i> Konfirmasi Hapus
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            @using (Html.BeginForm("DeleteProduk", "Admin", FormMethod.Post, new { id = "formHapusProduk" }))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" id="hapusProdukId" name="Id" />
                <div class="modal-body text-center">
                    <i class="ti-alert text-danger" style="font-size: 3rem;"></i>
                    <p class="mt-3 mb-1">Apakah Anda yakin ingin menghapus produk:</p>
                    <h6 class="font-weight-bold text-danger" id="hapusNamaProduk"></h6>
                    <p class="text-muted small">Tindakan ini tidak dapat dibatalkan.</p>
                </div>
                <div class="modal-footer justify-content-center">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Batal</button>
                    <button type="submit" class="btn btn-danger">
                        <i class="ti-trash me-1"></i> Hapus
                    </button>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.btnEdit').forEach(function (btn) {
            btn.addEventListener('click', function () {
                document.getElementById('editProdukId').value = this.dataset.id;
                document.getElementById('editNamaProduk').value = this.dataset.nama;
                document.getElementById('editHargaModal').value = this.dataset.hargamodal;
                document.getElementById('editHargaJual').value = this.dataset.hargajual;
                document.getElementById('editDeskripsi').value = this.dataset.deskripsi;
            });
        });

        document.querySelectorAll('.btnHapus').forEach(function (btn) {
            btn.addEventListener('click', function () {
                document.getElementById('hapusProdukId').value = this.dataset.id;
                document.getElementById('hapusNamaProduk').textContent = this.dataset.nama;
            });
        });
    </script>
}