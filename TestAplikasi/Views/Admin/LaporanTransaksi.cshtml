@{
    ViewBag.Title = "Laporan Transaksi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>Error!</strong> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row">
    <div class="col-md-12 grid-margin">
        <div class="row">
            <div class="col-12 col-xl-8 mb-4 mb-xl-0">
                <h3 class="font-weight-bold">
                    <i class="icon-file-text menu-icon"></i> Laporan Transaksi
                </h3>
                <h6 class="font-weight-normal mb-0">
                    Daftar seluruh transaksi yang telah dilakukan &mdash; @DateTime.Now.ToString("dddd, dd MMMM yyyy", new System.Globalization.CultureInfo("id-ID"))
                </h6>
            </div>
            <div class="col-12 col-xl-4">
                <div class="justify-content-end d-flex gap-2">
                    <button class="btn btn-primary btn-sm" onclick="window.print()">
                        <i class="icon-printer me-2"></i> Cetak
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <p class="card-title mb-0">Daftar Transaksi</p>
                    <div class="d-flex gap-2">
                        <input type="date" class="form-control form-control-sm" id="filterTglMulai" style="width: 150px;">
                        <input type="date" class="form-control form-control-sm" id="filterTglAkhir" style="width: 150px;">
                        <button class="btn btn-outline-primary btn-sm" onclick="filterTransaksi()">
                            <i class="icon-search"></i>
                        </button>
                        <button class="btn btn-outline-secondary btn-sm" onclick="resetFilter()">
                            <i class="icon-reload"></i>
                        </button>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover table-striped" id="transaksiTable">
                        <thead>
                            <tr>
                                <th>No</th>
                                <th>No. Transaksi</th>
                                <th>Tanggal</th>
                                <th>Kasir</th>
                                <th class="text-end">Total Harga</th>
                                <th class="text-end">Bayar</th>
                                <th class="text-end">Kembalian</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int no = 1;
                                var data = (List<dynamic>)ViewBag.DataLaporan;
                                if (data != null && data.Count > 0)
                                {
                                    foreach (var item in data)
                                    {
                                        <tr>
                                            <td>@no</td>
                                            <td><strong>@item.NomorTransaksi</strong></td>
                                            <td>@((DateTime)item.TanggalTransaksi).ToString("dd/MM/yyyy HH:mm")</td>
                                            <td>@item.NamaKasir</td>
                                            <td class="text-end"><strong>Rp @string.Format("{0:N0}", item.TotalHarga)</strong></td>
                                            <td class="text-end">Rp @string.Format("{0:N0}", item.Bayar)</td>
                                            <td class="text-end">Rp @string.Format("{0:N0}", item.Kembalian)</td>
                                        </tr>
                                        no++;
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="7" class="text-center text-muted">Tidak ada data transaksi</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function filterTransaksi() {
        const tglMulai = document.getElementById('filterTglMulai').value;
        const tglAkhir = document.getElementById('filterTglAkhir').value;

        if (tglMulai && tglAkhir && new Date(tglMulai) > new Date(tglAkhir)) {
            alert('Tanggal mulai tidak boleh lebih besar dari tanggal akhir');
            return;
        }

        const rows = document.getElementById('transaksiTable').querySelector('tbody').querySelectorAll('tr');
        rows.forEach(row => {
            if (row.cells.length > 2) {
                const tanggal = row.cells[2].textContent.split(' ')[0];
                let show = true;

                if (tglMulai) {
                    const tglRow = new Date(tanggal.split('/').reverse().join('-'));
                    if (tglRow < new Date(tglMulai)) show = false;
                }
                if (show && tglAkhir) {
                    const tglRow = new Date(tanggal.split('/').reverse().join('-'));
                    if (tglRow > new Date(tglAkhir)) show = false;
                }

                row.style.display = show ? '' : 'none';
            }
        });
    }

    function resetFilter() {
        document.getElementById('filterTglMulai').value = '';
        document.getElementById('filterTglAkhir').value = '';
        document.getElementById('transaksiTable').querySelector('tbody').querySelectorAll('tr').forEach(row => row.style.display = '');
    }
</script>
