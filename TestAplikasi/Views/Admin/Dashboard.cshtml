@{
    ViewBag.Title = "Dashboard Admin";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var topProduk = ViewBag.TopProduk as List<TestAplikasi.Models.DashboardProdukModel>;
    var performaKasir = ViewBag.PerformaKasir as List<TestAplikasi.Models.DashboardKasirModel>;
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>Error!</strong> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row">
    <div class="col-md-12 grid-margin">
        <div class="row">
            <div class="col-12 col-xl-8 mb-4 mb-xl-0">
                <h3 class="font-weight-bold">Analytics Dashboard</h3>
                <h6 class="font-weight-normal mb-0">Overview of your business performance &mdash; <span class="text-primary">@DateTime.Now.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("id-ID"))</span></h6>
            </div>
            <div class="col-12 col-xl-4">
                <div class="justify-content-end d-flex">
                    <div class="dropdown flex-md-grow-1 flex-xl-grow-0">
                        <button class="btn btn-sm btn-light bg-white dropdown-toggle" type="button" id="dropdownMenuDate2" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="true">
                            <i class="mdi mdi-calendar"></i> Today (@DateTime.Now.ToString("dd MMM yyyy"))
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-3 mb-4 stretch-card transparent">
        <div class="card card-tale">
            <div class="card-body">
                <p class="mb-4">Transaksi Hari Ini</p>
                <p class="fs-30 mb-2">@(ViewBag.TxHariIni ?? 0)</p>
                <p>Total transaksi hari ini</p>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-4 stretch-card transparent">
        <div class="card card-dark-blue">
            <div class="card-body">
                <p class="mb-4">Pendapatan Hari Ini</p>
                <p class="fs-30 mb-2">Rp @(ViewBag.PendapatanHariIni != null ? string.Format("{0:N0}", (decimal)ViewBag.PendapatanHariIni) : "0")</p>
                <p>Total omset hari ini</p>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-4 stretch-card transparent">
        <div class="card card-light-blue">
            <div class="card-body">
                <p class="mb-4">Total Stok</p>
                <p class="fs-30 mb-2">@(ViewBag.TotalStok ?? 0)</p>
                <p>Kuantitas seluruh produk</p>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-4 stretch-card transparent">
        <div class="card card-light-danger">
            <div class="card-body">
                <p class="mb-4">Stok Menipis</p>
                <p class="fs-30 mb-2">@(ViewBag.StokMenipis ?? 0)</p>
                <p>Produk di bawah limit</p>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-7 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <p class="card-title">Tren Penjualan (7 Hari)</p>
                    <a href="@Url.Action("LaporanTransaksi","Admin")" class="text-info">Lihat Detail</a>
                </div>
                <p class="font-weight-500 text-muted">Statistik pendapatan dan volume transaksi satu minggu terakhir.</p>
                <canvas id="sales-chart-enhanced"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-5 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <p class="card-title">Produk Terlaris</p>
                <p class="font-weight-500 text-muted">5 Produk dengan volume penjualan tertinggi.</p>
                <div class="mt-3">
                    <canvas id="top-products-doughnut"></canvas>
                </div>
                <div id="top-products-legend" class="chartjs-legend mt-4"></div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <p class="card-title mb-0">Performa Kasir</p>
                <div class="table-responsive">
                    <table class="table table-striped table-borderless">
                        <thead>
                            <tr>
                                <th>Kasir</th>
                                <th>Jumlah Transaksi</th>
                                <th>Total Penjualan</th>
                                <th>Pangsa Pasar</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (performaKasir != null)
                            {
                                decimal totalRevenue = performaKasir.Sum(k => k.TotalPendapatan);
                                foreach (var k in performaKasir)
                                {
                                    decimal share = totalRevenue > 0 ? (k.TotalPendapatan / totalRevenue) * 100 : 0;
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="me-3">
                                                    <div class="badge badge-outline-primary badge-pill" style="width: 35px; height: 35px; display: flex; align-items: center; justify-content: center;">
                                                        @k.NamaKasir.Substring(0, 1).ToUpper()
                                                    </div>
                                                </div>
                                                <div>
                                                    <p class="mb-0 font-weight-bold">@k.NamaKasir</p>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="font-weight-bold">@k.JumlahTransaksi</td>
                                        <td>Rp @string.Format("{0:N0}", k.TotalPendapatan)</td>
                                        <td>
                                            <div class="progress progress-md">
                                                <div class="progress-bar bg-primary" role="progressbar" style="width: @share.ToString("0")%" aria-valuenow="@share.ToString("0")" aria-valuemin="0" aria-valuemax="100"></div>
                                            </div>
                                        </td>
                                        <td><label class="badge badge-success">Active</label></td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function ($) {
            'use strict';
            $(function () {
                // Enhanced Sales Chart
                if ($("#sales-chart-enhanced").length) {
                    const ctx = document.getElementById('sales-chart-enhanced');
                    var labels = @Html.Raw(ViewBag.LabelGrafik ?? "[]");
                    var dataRevenue = @Html.Raw(ViewBag.DataGrafik ?? "[]");
                    var dataTx = @Html.Raw(ViewBag.DataTxGrafik ?? "[]");
                    
                    new Chart(ctx, {
                        type: 'line',
                        data: {
                            labels: labels,
                            datasets: [{
                                label: 'Pendapatan (Rp)',
                                data: dataRevenue,
                                borderColor: '#4B49AC',
                                backgroundColor: 'rgba(75, 73, 172, 0.1)',
                                fill: true,
                                tension: 0.4,
                                yAxisID: 'y',
                                pointRadius: 4,
                                pointBackgroundColor: '#4B49AC'
                            }, {
                                label: 'Jumlah Transaksi',
                                data: dataTx,
                                borderColor: '#FFC100',
                                backgroundColor: 'transparent',
                                borderDash: [5, 5],
                                tension: 0.4,
                                yAxisID: 'y1',
                                pointRadius: 4,
                                pointBackgroundColor: '#FFC100'
                            }]
                        },
                        options: {
                            responsive: true,
                            plugins: {
                                legend: {
                                    position: 'top',
                                    align: 'end',
                                    labels: { usePointStyle: true, boxWidth: 6 }
                                },
                                tooltip: {
                                    mode: 'index',
                                    intersect: false,
                                    callbacks: {
                                        label: function(context) {
                                            let label = context.dataset.label || '';
                                            if (label) label += ': ';
                                            if (context.datasetIndex === 0) {
                                                label += 'Rp ' + context.parsed.y.toLocaleString('id-ID');
                                            } else {
                                                label += context.parsed.y + ' tx';
                                            }
                                            return label;
                                        }
                                    }
                                }
                            },
                            scales: {
                                x: { grid: { display: false } },
                                y: {
                                    type: 'linear',
                                    display: true,
                                    position: 'left',
                                    grid: { color: '#f3f3f3' },
                                    ticks: {
                                        callback: function(v) { return 'Rp ' + (v/1000) + 'k'; }
                                    }
                                },
                                y1: {
                                    type: 'linear',
                                    display: true,
                                    position: 'right',
                                    grid: { drawOnChartArea: false },
                                    ticks: { stepSize: 1 }
                                }
                            }
                        }
                    });
                }

                // Top Products Doughnut
                if ($("#top-products-doughnut").length) {
                    const ctx = document.getElementById('top-products-doughnut');
                    var labelsProduk = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(topProduk?.Select(p => p.NamaProduk).ToList() ?? new List<string>()));
                    var dataProduk = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(topProduk?.Select(p => p.TotalTerjual).ToList() ?? new List<int>()));

                    const chart = new Chart(ctx, {
                        type: 'doughnut',
                        data: {
                            labels: labelsProduk,
                            datasets: [{
                                data: dataProduk,
                                backgroundColor: ["#4B49AC", "#FFC100", "#248AFD", "#FF4747", "#57B657"],
                                borderColor: "white",
                                borderWidth: 3
                            }]
                        },
                        options: {
                            cutout: '75%',
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: { display: false }
                            }
                        }
                    });

                    // Custom Legend
                    const legendContainer = document.getElementById('top-products-legend');
                    if (legendContainer) {
                        const ul = document.createElement('ul');
                        ul.className = 'list-unstyled';
                        chart.data.labels.forEach((label, i) => {
                            const val = chart.data.datasets[0].data[i];
                            ul.innerHTML += `
                                <li class="d-flex align-items-center mb-2">
                                    <span class="me-2" style="width: 10px; height: 10px; border-radius: 50%; background-color: ${chart.data.datasets[0].backgroundColor[i]}"></span>
                                    <span class="text-muted small">${label}</span>
                                    <span class="ms-auto font-weight-bold small">${val} unit</span>
                                </li>
                            `;
                        });
                        legendContainer.appendChild(ul);
                    }
                }
            });
        })(jQuery);
    </script>
}