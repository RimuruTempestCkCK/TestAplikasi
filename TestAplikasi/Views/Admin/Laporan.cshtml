                                <td>Penjualan</td>
                                <td class="font-weight-bold">Rp 3.750.000</td>
                                <td><label class="badge badge-success">Selesai</label></td>
                            </tr>
                            <tr>
                                <td>4</td>
                                <td>04 Jan 2024</td>
                                <td>TRX-20240104-004</td>
                                <td>Pengguna</td>
                                <td class="font-weight-bold">Rp 800.000</td>
                                <td><label class="badge badge-danger">Dibatalkan</label></td>
                            </tr>
                            <tr>
                                <td>5</td>
                                <td>05 Jan 2024</td>
                                <td>TRX-20240105-005</td>
                                <td>Transaksi</td>
                                <td class="font-weight-bold">Rp 4.100.000</td>
                                <td><label class="badge badge-success">Selesai</label></td>
