<script>
    // ===== FILTER FUNCTIONALITY =====
    document.getElementById('btnFilter').addEventListener('click', function() {
        const kategori = document.getElementById('kategoriLaporan').value;
        const tglMulai = document.getElementById('tanggalMulai').value;
        const tglAkhir = document.getElementById('tanggalAkhir').value;

        if (!kategori) {
            alert('Pilih kategori laporan terlebih dahulu');
            return;
        }

        if (tglMulai && tglAkhir) {
            if (new Date(tglMulai) > new Date(tglAkhir)) {
                alert('Tanggal mulai tidak boleh lebih besar dari tanggal akhir');
                return;
            }
        }

        // Redirect ke laporan yang dipilih
        const routes = {
            'transaksi': '@Url.Action("LaporanTransaksi", "Admin")',
            'stok': '@Url.Action("LaporanStok", "Admin")',
            'penambahan': '@Url.Action("LaporanPenambahStok", "Admin")'
        };

        if (routes[kategori]) {
            let url = routes[kategori];
            if (tglMulai) url += '?mulai=' + tglMulai;
            if (tglAkhir) url += (tglMulai ? '&' : '?') + 'akhir=' + tglAkhir;
            window.location.href = url;
        }
    });

    document.getElementById('btnReset').addEventListener('click', function() {
        document.getElementById('tanggalMulai').value = '';
        document.getElementById('tanggalAkhir').value = '';
        document.getElementById('kategoriLaporan').value = '';
        document.getElementById('sortBy').value = 'terbaru';
    });

    document.getElementById('btnExport').addEventListener('click', function() {
        alert('Fitur export akan dihubungkan ke controller');
    });

     //===== LINE CHART: Tren Transaksi =====
    var ctxLine = document.getElementById('lineChart').getContext('2d');
    new Chart(ctxLine, {
        type: 'line',
        data: {
            labels: ['Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun', 'Jul', 'Ags', 'Sep', 'Okt', 'Nov', 'Des'],
            datasets: [{
                label: 'Transaksi 2024',
                data: [520, 680, 740, 610, 820, 910, 870, 950, 1020, 890, 760, 1100],
                borderColor: '#4B49AC',
                backgroundColor: 'rgba(75, 73, 172, 0.1)',
                borderWidth: 2,
                fill: true,
                tension: 0.4,
                pointBackgroundColor: '#4B49AC',
                pointRadius: 4
            }, {
                label: 'Transaksi 2023',
                data: [410, 530, 600, 490, 710, 780, 720, 800, 860, 740, 650, 920],
                borderColor: '#98BDFF',
                backgroundColor: 'rgba(152, 189, 255, 0.1)',
                borderWidth: 2,
                fill: true,
                tension: 0.4,
                pointBackgroundColor: '#98BDFF',
                pointRadius: 4
            }]
        },
        options: {
            responsive: true,
            plugins: { legend: { position: 'bottom' } },
            scales: {
                y: { beginAtZero: true, grid: { color: 'rgba(0,0,0,0.05)' } },
                x: { grid: { display: false } }
            }
        }
    });

    // ===== BAR CHART: Pendapatan per Kategori =====
    var ctxBar = document.getElementById('barChart').getContext('2d');
    new Chart(ctxBar, {
        type: 'bar',
        data: {
            labels: ['Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun', 'Jul', 'Ags', 'Sep', 'Okt', 'Nov', 'Des'],
            datasets: [{
                label: 'Penjualan',
                data: [42, 58, 65, 47, 73, 88, 76, 91, 85, 69, 54, 98],
                backgroundColor: '#4B49AC'
            }, {
                label: 'Transaksi',
                data: [28, 35, 42, 31, 55, 61, 58, 67, 72, 48, 39, 74],
                backgroundColor: '#98BDFF'
            }, {
                label: 'Pengguna',
                data: [15, 22, 28, 19, 34, 41, 37, 45, 38, 29, 24, 51],
                backgroundColor: '#F9E59B'
            }]
        },
        options: {
            responsive: true,
            plugins: { legend: { position: 'bottom' } },
            scales: {
                y: { beginAtZero: true, grid: { color: 'rgba(0,0,0,0.05)' } },
                x: { grid: { display: false } }
            }
        }
    });

    // ===== DOUGHNUT CHART: Distribusi Kategori =====
    var ctxDoughnut = document.getElementById('doughnutChart').getContext('2d');
    new Chart(ctxDoughnut, {
        type: 'doughnut',
        data: {
            labels: ['Penjualan', 'Transaksi', 'Pengguna', 'Lainnya'],
            datasets: [{
                data: [45, 30, 18, 7],
                backgroundColor: ['#4B49AC', '#98BDFF', '#F9E59B', '#F3B729'],
                borderWidth: 0,
                hoverOffset: 8
            }]
        },
        options: {
            responsive: true,
            cutout: '70%',
            plugins: {
                legend: { position: 'bottom' }
            }
        }
    });

    // ===== PIE CHART: Status Laporan =====
    var ctxPie = document.getElementById('pieChart').getContext('2d');
    new Chart(ctxPie, {
        type: 'pie',
        data: {
            labels: ['Selesai', 'Pending', 'Diproses', 'Dibatalkan'],
            datasets: [{
                data: [62, 18, 12, 8],
                backgroundColor: ['#00d25b', '#ffab00', '#4B49AC', '#fc424a'],
                borderWidth: 2,
                borderColor: '#fff',
                hoverOffset: 8
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: { position: 'bottom' }
            }
        }
    });
</script>

<style>
    /* Filter Card Styling */
    .card-body .row {
        gap: 1rem;
    }

    .form-label {
        font-size: 0.85rem;
        text-transform: uppercase;
        color: #666;
        letter-spacing: 0.5px;
