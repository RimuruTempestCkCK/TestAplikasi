@{
    ViewBag.Title = "Laporan";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@*{{!-- ===== FILTER LAPORAN ===== --}}*@
<div class="row">
    <div class="col-lg-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">Filter Laporan</h4>
                <p class="card-description">Pilih rentang tanggal dan kategori laporan yang ingin ditampilkan.</p>
                <div class="row">
                    <div class="col-md-3">
                        <div class="form-group">
                            <label for="tanggalMulai">Tanggal Mulai</label>
                            <input type="date" class="form-control" id="tanggalMulai" />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label for="tanggalAkhir">Tanggal Akhir</label>
                            <input type="date" class="form-control" id="tanggalAkhir" />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label for="kategoriLaporan">Kategori</label>
                            <select class="form-select" id="kategoriLaporan">
                                <option value="semua">Semua Kategori</option>
                                <option value="penjualan">Penjualan</option>
                                <option value="pengguna">Pengguna</option>
                                <option value="transaksi">Transaksi</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-3 d-flex align-items-end">
                        <div class="form-group w-100">
                            <button type="button" class="btn btn-primary btn-fw me-2" id="btnFilter">
                                <i class="ti-filter me-1"></i> Tampilkan
                            </button>
                            <button type="button" class="btn btn-outline-secondary btn-fw" id="btnReset">
                                <i class="ti-reload me-1"></i> Reset
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@*{{!-- ===== RINGKASAN STATISTIK ===== --}}*@
<div class="row">
    <div class="col-md-3 grid-margin stretch-card">
        <div class="card card-tale">
            <div class="card-body">
                <p class="mb-4">Total Transaksi</p>
                <p class="fs-30 mb-2">8,540</p>
                <p><i class="ti-arrow-up text-white me-1"></i>12.5% dari bulan lalu</p>
            </div>
        </div>
    </div>
    <div class="col-md-3 grid-margin stretch-card">
        <div class="card card-dark-blue">
            <div class="card-body">
                <p class="mb-4">Total Pendapatan</p>
                <p class="fs-30 mb-2">Rp 124 Jt</p>
                <p><i class="ti-arrow-up text-white me-1"></i>8.3% dari bulan lalu</p>
            </div>
        </div>
    </div>
    <div class="col-md-3 grid-margin stretch-card">
        <div class="card card-light-blue">
            <div class="card-body">
                <p class="mb-4">Pengguna Aktif</p>
                <p class="fs-30 mb-2">3,210</p>
                <p><i class="ti-arrow-up text-white me-1"></i>5.1% dari bulan lalu</p>
            </div>
        </div>
    </div>
    <div class="col-md-3 grid-margin stretch-card">
        <div class="card card-light-danger">
            <div class="card-body">
                <p class="mb-4">Laporan Pending</p>
                <p class="fs-30 mb-2">47</p>
                <p><i class="ti-arrow-down text-white me-1"></i>3.2% dari bulan lalu</p>
            </div>
        </div>
    </div>
</div>

@*{{!-- ===== GRAFIK BARIS 1 ===== --}}*@
<div class="row">
    <div class="col-lg-8 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4 class="card-title mb-0">Tren Transaksi Bulanan</h4>
                    <div class="dropdown">
                        <button class="btn btn-sm btn-light bg-white dropdown-toggle" type="button"
                                data-bs-toggle="dropdown">
                            <i class="mdi mdi-calendar"></i> 2024
                        </button>
                        <div class="dropdown-menu dropdown-menu-right">
                            <a class="dropdown-item" href="#">2024</a>
                            <a class="dropdown-item" href="#">2023</a>
                            <a class="dropdown-item" href="#">2022</a>
                        </div>
                    </div>
                </div>
                <canvas id="lineChart"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-4 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">Distribusi Kategori</h4>
                <div class="doughnutjs-wrapper d-flex justify-content-center">
                    <canvas id="doughnutChart"></canvas>
                </div>
                <div id="doughnutLegend" class="mt-3"></div>
            </div>
        </div>
    </div>
</div>

@*{{!-- ===== GRAFIK BARIS 2 ===== --}}*@
<div class="row">
    <div class="col-lg-6 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">Pendapatan per Kategori</h4>
                <canvas id="barChart"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-6 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">Persentase Status Laporan</h4>
                <div class="doughnutjs-wrapper d-flex justify-content-center">
                    <canvas id="pieChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

@*{{!-- ===== TABEL DETAIL LAPORAN ===== --}}*@
